# Local (default) mode: SQLite file database, no external services required.
DATA_DIR=./data

# Used in server-generated links and documentation.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Controls the "Explorar demonstração" button on the login page.
# 1: enabled. 0: disabled. Empty: enabled only outside production, if the demo user exists.
DEMO_MODE=

# Supabase deployment path (optional, see supabase/migrations/0001_init.sql).
# The local demo does not read these. Never expose the service role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
